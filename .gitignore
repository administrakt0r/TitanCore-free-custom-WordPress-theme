# Whitelist model: only the versioned theme (plus top-level docs) ships to GitHub.
# Everything not explicitly un-ignored below stays local.
/*

# Tracked on GitHub
!/.gitignore
!/.gitattributes
!/README.md
!/CHANGELOG.md
!/RELEASING.md
!/TODO.md
!/start-guide.md
!/AGENTS.md
!/AGENTARDS/
!/docs/
!/bin/
!/.wp-env.json
!/opencode.json
!/themeversions/

# Runtime pointer, machine-local — not versioned
themeversions/current

# Agent + local secrets
.mcp/

# Local env / tooling / OS junk (already covered by the whitelist, kept for safety)
.wp-env/
node_modules/
vendor/
.DS_Store
Thumbs.db
*.log
*.map
